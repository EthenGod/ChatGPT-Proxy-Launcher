{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Launcher",
  "mainBinaryName": "ChatGPTLauncherSetup",
  "version": "1.1.3",
  "identifier": "io.github.ethengod.chatgpt-launcher-setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT Launcher",
        "theme": "Dark",
        "width": 640,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "create": false,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "setup-readonly"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/ChatGPT.ico"
    ]
  }
}
