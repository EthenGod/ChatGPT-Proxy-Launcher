{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "链式启动就绪回执 v1",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schemaVersion", "runId", "attemptId", "token", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"$ref": "#/$defs/identity"},
    "attemptId": {"$ref": "#/$defs/identity"},
    "token": {"$ref": "#/$defs/identity"}
  },
  "oneOf": [
    {"properties": {"status": {"const": "ready"}}},
    {
      "required": ["errorCode", "retryable"],
      "properties": {
        "status": {"const": "failed"},
        "errorCode": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$"},
        "retryable": {"type": "boolean"},
        "message": {"type": "string", "maxLength": 256}
      }
    },
    {
      "required": ["readyProcessId", "readyProcessCreationTime"],
      "properties": {
        "status": {"const": "already-running"},
        "readyProcessId": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "readyProcessCreationTime": {"type": "string", "pattern": "^[0-9a-fA-F]{16}$"}
      }
    }
  ],
  "$comment": "最多 4096 UTF-8 字节。身份字段必须原样复制本次上下文。先写 reply.json.tmp，关闭文件后同目录改名，不覆盖旧回执。运行时另查期限、进程创建时间、用户和会话；永久错误忽略 retryable=true。"
}
